DATABASE_URL="postgresql://user:password@localhost:5432/clawlab?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Claw Lab"

# SMTP pour l'email de confirmation de réservation
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="change-me"
MAIL_FROM="Claw lab <no-reply@clawlab.be>"
# Adresse qui reçoit une notification à chaque nouvelle réservation (défaut : SMTP_USER)
NOTIFY_EMAIL="user@example.com"

# Lien direct vers le formulaire d'avis Google (bouton "Demander un avis" en admin)
GOOGLE_REVIEW_URL="https://g.page/r/XXXXXXXX/review"

# Domaine public utilisé pour les images/liens dans les emails (toujours le vrai domaine,
# même en testant depuis un serveur local pointé sur la base de prod)
PUBLIC_SITE_URL="https://www.clawlab.be"
